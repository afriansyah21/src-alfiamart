PORT=3000
# Neon/Render memberikan DATABASE_URL; contoh lokal:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/src_alfiamart
# Isi true untuk database cloud (Neon)
DATABASE_SSL=false
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=12h
# Asal front-end yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173
# Kunci untuk layanan DS/AE membaca endpoint /api/v1/export/*
SERVICE_API_KEY=ganti-kunci-layanan-ds-ae

# Integrasi layanan AI FastAPI
# Base URL Express ke FastAPI, tanpa endpoint /v1/chat atau /v1/summaries
AI_SERVICE_URL=http://localhost:8000
# Kunci rahasia server-to-server; jangan pernah kirim ke front-end atau log
AI_INTERNAL_KEY=ganti-dengan-kunci-internal-antara-express-dan-ai
# Opsional untuk development/test: fallback, no_data, slow, unavailable, crash
AI_STUB_SCENARIO=
