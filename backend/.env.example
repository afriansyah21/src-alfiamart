PORT=3000
# Neon/Render memberikan DATABASE_URL; contoh lokal:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/src_alfiamart
# Isi true untuk database cloud (Neon)
DATABASE_SSL=false
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=12h
# Asal front-end yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173
# Kunci untuk layanan DS/AE membaca endpoint /api/v1/export/*
SERVICE_API_KEY=ganti-kunci-layanan-ds-ae
