# Kunci rahasia antara Express dan layanan AI (header X-Internal-Key).
# Isi dengan string acak yang panjang, lalu bagikan ke Ammar lewat chat pribadi.
# File .env TIDAK BOLEH di-commit.
INTERNAL_API_KEY=ganti-dengan-string-acak-panjang

# true = header X-Stub-Scenario aktif, untuk menguji penanganan error di Express.
# Isi false di server publik.
STUB_SCENARIOS=true
